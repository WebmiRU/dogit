# Local configuration for the development stack. Copy to .env and adjust.
# Every setting here has a working default, so an empty .env still starts.

# --- database -------------------------------------------------------------
POSTGRES_USER=dogit
POSTGRES_PASSWORD=dogit
POSTGRES_DB=dogit

# --- application ----------------------------------------------------------
DOGIT_ENV=development
DOGIT_LOG_LEVEL=debug

# Git hooks write to the pusher's terminal, so they are quieter than the server.
DOGIT_HOOK_LOG_LEVEL=warn

# Hostname shown in clone URLs. Set this to the domain you serve from.
DOGIT_SSH_HOST=localhost

# Client-facing SSH port, as published by docker compose. It appears in clone URLs
# when it is not 22, which during development it is not.
DOGIT_SSH_PORT=2222

# Browser origins allowed to use the cookie session for state-changing requests.
# Must list every origin the UI is served from; anything else is rejected.
DOGIT_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# Instance token for the reference module. Create one with:
#   docker compose exec app dogit module token create --name registry-demo
# DOGIT_MODULE_TOKEN=glpat-...

# Number of CI jobs the runner executes in parallel.
DOGIT_RUNNER_CONCURRENCY=2