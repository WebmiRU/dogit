# Git-over-SSH front end.
#
# Every inbound connection is authenticated by the system sshd, which delegates
# key lookup to dogit and then force-executes dogit-hook. dogit itself never
# speaks SSH: keeping the audited implementation out of this project is the whole
# point of this arrangement.

Port 22
AddressFamily any
ListenAddress 0.0.0.0

HostKey /etc/ssh/ssh_host_ed25519_key
HostKey /etc/ssh/ssh_host_rsa_key

# Public key authentication only, and only through dogit.
PubkeyAuthentication yes
PasswordAuthentication no
KbdInteractiveAuthentication no
PermitEmptyPasswords no
PermitRootLogin no

# Key lookup: sshd calls dogit with the username it has already authenticated,
# and dogit prints the registered keys with a forced command attached.
AuthorizedKeysCommand /usr/local/bin/dogit authorized-keys %u
AuthorizedKeysCommandUser git
AuthorizedKeysFile none

# The forced command in the key line already restricts everything, these are
# belt and braces in case a key ever arrives without it.
PermitUserEnvironment no
X11Forwarding no
AllowAgentForwarding no
AllowTcpForwarding no
PermitTunnel no
PermitTTY no

MaxAuthTries 6
MaxSessions 8
LoginGraceTime 60

# git clients are chatty but small; a 4 MB burst covers packfile negotiation.
Subsystem sftp /usr/lib/ssh/sftp-server

ClientAliveInterval 300
ClientAliveCountMax 2

LogLevel VERBOSE
# Clients log in as "git", which is an unprivileged account owning /data/repos,
# so every child process is already unprivileged. ForceUser is intentionally not
# set: OpenSSH 10 (used by current Alpine images) no longer accepts it here, and
# it would be redundant anyway.
AllowUsers git
